# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# WhatsApp Cloud API (configurado por tenant no banco; estes sao defaults globais)
WHATSAPP_VERIFY_TOKEN=change-me-to-a-long-random-string
META_APP_SECRET=

# Criptografia de tokens sensiveis no banco (32+ chars)
ENCRYPTION_KEY=change-me-32-chars-minimum-secret

# n8n (webhook interno para disparo de follow-ups e SDR de IA)
N8N_WEBHOOK_BASE_URL=http://n8n:5678
N8N_WEBHOOK_SECRET=change-me

# Brasil API (sem chave; placeholder caso troque pra Casa dos Dados/ReceitaWS)
BRASIL_API_BASE_URL=https://brasilapi.com.br/api
